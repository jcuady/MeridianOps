# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=meridian_root
MYSQL_DATABASE=meridianops
MYSQL_USER=meridian
MYSQL_PASSWORD=meridian_pass

# Backend
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/meridianops?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=meridian
SPRING_DATASOURCE_PASSWORD=meridian_pass
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
